# PostgreSQL connection string (Supabase, Neon, RDS, local Postgres, etc.)
# Example Supabase pooled connection:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbt_quran_academy"

# Random long secret used to sign session JWTs. Generate with:
# openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-secret"

# Optional: base URL used in generated links, emails, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
